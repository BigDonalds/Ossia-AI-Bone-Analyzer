  "atlasSkullBlurb": "Cranium and mandible together",
  "@atlasSkullBlurb": {
    "description": "Atlas: one line under the bone name in the list"
  },
  "atlasSkullSummary": "The complete bony head: the cranium together with the mandible. Twenty-two bones in all, joined by interlocking sutures; only the mandible articulates freely.",
  "@atlasSkullSummary": {
    "description": "Atlas, anatomy text for experts. Keep the Latin terms where your language uses them"
  },
  "atlasSkullLm1": "Coronal, sagittal and lambdoid sutures",
  "@atlasSkullLm1": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasSkullLm2": "Orbits and the piriform (nasal) aperture",
  "@atlasSkullLm2": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasSkullLm3": "Foramen magnum on the basicranium",
  "@atlasSkullLm3": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasSkullLm4": "Mastoid processes behind the ear canals",
  "@atlasSkullLm4": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasSkullSiding": "Symmetrical. Orientation comes from the frontal bone (anterior) and the occipital squama (posterior).",
  "@atlasSkullSiding": {
    "description": "Atlas: how to tell left from right, or the place in a series"
  },
  "atlasCraniumBlurb": "The skull without its jaw",
  "@atlasCraniumBlurb": {
    "description": "Atlas: one line under the bone name in the list"
  },
  "atlasCraniumSummary": "The skull with the mandible removed. Encloses and protects the brain; the vault is made of frontal, parietal, temporal and occipital bones.",
  "@atlasCraniumSummary": {
    "description": "Atlas, anatomy text for experts. Keep the Latin terms where your language uses them"
  },
  "atlasCraniumLm1": "Supraorbital ridges — heavier in male crania",
  "@atlasCraniumLm1": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasCraniumLm2": "Nuchal lines on the occipital",
  "@atlasCraniumLm2": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasCraniumLm3": "Temporal lines sweeping across the parietals",
  "@atlasCraniumLm3": {
    "description": "Atlas: one thing an expert looks for on this bone"
  },
  "atlasCraniumLm4": "External auditory meatus",
  "@atlasCraniumLm4": {
    "description": "Atlas: one thing an expert looks for on this bone"
